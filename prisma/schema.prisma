generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id             String   @id @default(cuid())
  clerkId        String   @unique
  toolsUsedCount Int      @default(0)
  createdAt      DateTime @default(now())
}

model ToolUsage {
  id        String   @id @default(cuid())
  userId    String
  toolSlug  String
  createdAt DateTime @default(now())

  @@unique([userId, toolSlug])
}

model FavoriteTool {
  id        String   @id @default(cuid())
  userId    String
  toolSlug  String
  createdAt DateTime @default(now())

  @@unique([userId, toolSlug])
}